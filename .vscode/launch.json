{
	"version": "0.2.0",
	"configurations": [
			{
					"name": "Debug nitcbase",
					"cwd": "${workspaceFolder}",
					"type": "cppdbg",
					"request": "launch",
					"program": "${workspaceFolder}/nitcbase", // Binary to exec
					"stopAtEntry": false,
					"environment": [],
					"externalConsole": false,
					"MIMode": "gdb",
					"setupCommands": [
							{
									"description": "Enable pretty-printing for gdb",
									"text": "-enable-pretty-printing",
									"ignoreFailures": true
							}
					],
					"preLaunchTask": "${defaultBuildTask}",
					"miDebuggerPath": "/usr/bin/gdb"
			}
	]
}